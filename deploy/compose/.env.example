# Copy to .env and adjust. Never commit .env.
# Generate every secret below with: openssl rand -hex 32

# ============ Which containers start ============
# Comma-separated Docker Compose profiles:
#   db  = bundled PostgreSQL   dev = Mailpit (email catcher)   s3 = MinIO
# Using your own Postgres? Remove "db" and set MINIBASE_DATABASE_URL below.
COMPOSE_PROFILES=db

# ============ Database ============
# Bundled Postgres (db profile): password for the "postgres" superuser.
POSTGRES_PASSWORD=change-me
# Host port for connecting with psql/DBeaver (localhost only). Change if 5432 is taken.
POSTGRES_PORT=5432

# External Postgres instead (leave commented when using the bundled one).
# The user needs CREATEROLE (mini-base creates two request roles).
# MINIBASE_DATABASE_URL=postgres://user:password@db.example.com:5432/minibase?sslmode=require

# ============ Which features run inside minibase ============
# Comma-separated modules. Available: admin, auth, database, example
MINIBASE_MODULES=admin,auth,database

# ============ API keys (required by auth and database) ============
# Clients send one of them in the "apikey" header.
# anon:    safe to ship in browser/mobile apps; access is limited by RLS policies.
# service: full access, bypasses RLS. Servers only — never ship it to clients.
MINIBASE_ANON_KEY=change-me
MINIBASE_SERVICE_KEY=change-me

# ============ auth module ============
# Signs access tokens. Changing it signs everyone out.
MINIBASE_AUTH_JWT_SECRET=change-me
# MINIBASE_AUTH_ACCESS_TOKEN_TTL=15m
# MINIBASE_AUTH_SESSION_TTL=720h
# MINIBASE_AUTH_PASSWORD_MIN_LENGTH=8
# MINIBASE_AUTH_ALLOW_SIGNUP=true
# MINIBASE_AUTH_RATE_LIMIT_PER_MINUTE=30

# ============ admin module (dashboard at http://localhost:8090/_/) ============
# Create the first admin automatically on start (if none exists), then remove
# the password from this file. Or run: minibase admin create --email you@example.com
# MINIBASE_ADMIN_EMAIL=you@example.com
# MINIBASE_ADMIN_PASSWORD=at-least-12-characters
# Set true when the dashboard is served over HTTPS (e.g. behind a reverse proxy).
# MINIBASE_ADMIN_SECURE_COOKIE=false
# MINIBASE_ADMIN_SESSION_TTL=12h
# MINIBASE_ADMIN_SQL_TIMEOUT=30s

# ============ database module ============
# MINIBASE_DATABASE_SCHEMAS=public
# MINIBASE_DATABASE_MAX_ROWS=1000
# MINIBASE_DATABASE_STATEMENT_TIMEOUT=8s
# Unsafe: lets anon/signed-in users reach tables without row level security.
# MINIBASE_DATABASE_ALLOW_TABLES_WITHOUT_RLS=false

# ============ Server ============
# development | production (production = stricter defaults, JSON logs)
MINIBASE_ENV=development
# Host port for the API
MINIBASE_PORT=8090
# debug | info | warn | error
MINIBASE_LOG_LEVEL=info
# Browser origins allowed by CORS ("*" = any; the development default)
# MINIBASE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============ Tuning (defaults shown) ============
# MINIBASE_DATABASE_MAX_CONNS=10
# MINIBASE_DATABASE_CONNECT_TIMEOUT=30s
# MINIBASE_HTTP_MAX_BODY_BYTES=10485760
# MINIBASE_HTTP_SHUTDOWN_TIMEOUT=15s
