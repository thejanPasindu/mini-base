# Copy to .env and adjust. Never commit .env.

# --- Required ---
POSTGRES_PASSWORD=change-me

# --- Server ---
# development | production (production = stricter defaults, JSON logs)
MINIBASE_ENV=development
# Modules to enable, comma-separated. Available in this build: example
MINIBASE_MODULES=example
# Host port to publish
MINIBASE_PORT=8090
# debug | info | warn | error
MINIBASE_LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS ("*" = any; dev default)
# MINIBASE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Tuning (defaults shown) ---
# MINIBASE_DATABASE_MAX_CONNS=10
# MINIBASE_DATABASE_CONNECT_TIMEOUT=30s
# MINIBASE_HTTP_MAX_BODY_BYTES=10485760
# MINIBASE_HTTP_SHUTDOWN_TIMEOUT=15s
